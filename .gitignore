# Datos generados por el pipeline (se regeneran con actualizar_productos y
# quedan respaldados en backups/). Versionarlos infla el repo: con la tarea
# programada 2 veces al dia serian ~20 MB de diff por corrida.
data/*_real.csv
data/*_real.csv.bak
data/*_real.csv.nuevo
data/productos_supermercados.csv
# Segunda fuente de Lider (SPA): datos, como los *_real.csv
data/lider_browse.csv
data/lider_browse.csv.nuevo

# EXCEPCION a lo de arriba: data/ean_cache.json SI se versiona. Los CSV se
# regeneran en ~35 min por cadena, pero la cache de EAN cuesta decenas de miles
# de requests contra cuotas de los retailers (horas, con throttling). Pesa medio
# MB, crece de a poco y el EAN de un producto no cambia nunca: versionarla es el
# unico respaldo fuera del disco local.
