JUMBO_API_KEY=replace_me

# --- Endurecimiento de la API (solo en el servidor; en local dejar sin definir) ---
# Dominios extra permitidos por CORS, separados por coma. La red local siempre pasa.
# AHORRAGO_ORIGENES=https://ahorrago.cl,https://www.ahorrago.cl
# Con esto definido, /diagnostico/* y /estado-datos exigen el header x-admin-token.
# Sin definir, quedan abiertos: es el modo desarrollo. (El token va SOLO por header,
# nunca por ?token=: terminaria en los logs y el historial.)
# AHORRAGO_ADMIN_TOKEN=pone-aca-un-token-largo-y-aleatorio
# Peticiones por minuto y por IP. 0 desactiva el limite. Default 120.
# AHORRAGO_LIMITE_MINUTO=120
# Activar SOLO si la API vive detras de un proxy inverso propio que reescribe
# X-Forwarded-For. Si no, dejar sin definir: de lo contrario se puede spoofear la
# IP y saltear el rate limit.
# AHORRAGO_CONFIAR_PROXY=1
# --- Webhook de WhatsApp (Twilio) ---
# Con el auth token definido, el webhook exige la firma X-Twilio-Signature valida.
# Sin definir, no valida nada (desarrollo).
# TWILIO_AUTH_TOKEN=el-auth-token-de-tu-cuenta-twilio
# La URL publica exacta que Twilio llama (con TLS el esquema no coincide con el
# interno). Necesaria para que la firma cuadre detras de un proxy.
# AHORRAGO_WEBHOOK_URL=https://ahorrago.cl/webhook/whatsapp
